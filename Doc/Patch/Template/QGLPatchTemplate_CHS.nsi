Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile "..\..\..\${PRODUCT_OUTPUT_FOLDER}\qgl_${PRODUCT_SUPPORT_FROM_VERSION}.${PRODUCT_SUPPORT_FROM_PATCH_VERSION}_${PRODUCT_DESTINATION_VERSION}.${PRODUCT_DESTINATION_PATCH_VERSION}_patch.exe"
InstallDir "$PROGRAMFILES\Purple\QGL"
InstallDirRegKey HKLM "${PRODUCT_DIR_REGKEY}" ""
ShowInstDetails show
ShowUnInstDetails show

Function AttachSpecialEXE
  File "${EXTRA_APP_1}"

  StrLen $0 "$INSTDIR"
  IntCmp $0 11 instdir_nottarget instdir_nottarget instdir_istarget
instdir_istarget:
    StrCpy $1 "$INSTDIR" 11 -11
    StrCmp $1 "patch\trash" 0 +7
      IntOp $3 $0 - 12
      StrCpy $2 "$INSTDIR" $3 0
      IfFileExists "$2\QGLPU.bin" 0 +3           ;autopatch case
        CreateShortCut "$SMPROGRAMS\紫界网络\梦幻古龙\安装梦幻古龙体验服0.5.lnk" "$2\${EXTRA_APP_1}"
        CreateShortCut "$DESKTOP\安装梦幻古龙体验服0.5.lnk" "$2\${EXTRA_APP_1}"
      Goto after_shortcut
instdir_nottarget:
      IfFileExists "$INSTDIR\QGLPU.bin" 0 +3    ;manual case
        CreateShortCut "$SMPROGRAMS\紫界网络\梦幻古龙\安装梦幻古龙体验服0.5.lnk" "$INSTDIR\${EXTRA_APP_1}"
        CreateShortCut "$DESKTOP\安装梦幻古龙体验服0.5.lnk" "$INSTDIR\${EXTRA_APP_1}"
      Goto after_shortcut
after_shortcut:
FunctionEnd

Function WriteToFile
 Exch $0 ;file to write to
 Exch
 Exch $1 ;text to write

  FileOpen $0 $0 w #open file
   FileSeek $0 0 SET #go to end
   FileWrite $0 $1 #write to file
  FileClose $0

 Pop $1
 Pop $0
FunctionEnd

!macro WriteToFile String File
 Push "${String}"
 Push "${File}"
  Call WriteToFile
!macroend
!define WriteToFile "!insertmacro WriteToFile"

;Function CustomPageFunction
;InstallOptions::dialog "testbmp.ini"
