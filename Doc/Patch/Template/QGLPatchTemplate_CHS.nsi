!endif
!ifndef PRODUCT_DESTINATION_VERSION
        !error "PRODUCT_DESTINATION_VERSION not defined"
!endif
!ifndef PRODUCT_DESTINATION_PATCH_VERSION
        !error "PRODUCT_DESTINATION_PATCH_VERSION not defined"
!endif

SetCompressor /FINAL lzma

