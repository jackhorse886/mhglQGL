!include InstallOptions.nsh
; Script generated by the HM NIS Edit Script Wizard.

; HM NIS Edit Wizard helper defines
!define PRODUCT_NAME "梦幻古龙"
!define PRODUCT_BUILD   "$CURRENT_REVISION$"
!define PRODUCT_VERSION "$MAJOR_CURRENT_VERSION$.$CURRENT_REVISION$"
!define PRODUCT_SUPPORT_FROM_VERSION "$MAJOR_SUPPORT_VERSION$.$SUPPORT_REVISION$"
!define PRODUCT_SUPPORT_FROM_PATCH_VERSION "$SUPPORT_VERSION$"
!define PRODUCT_DESTINATION_VERSION "${PRODUCT_VERSION}"
!define PRODUCT_DESTINATION_PATCH_VERSION "$CURRENT_VERSION$"
!define PRODUCT_REVERT_FLAG "$REVERT_FLAG$"
!define PRODUCT_OUTPUT_FOLDER "$OUTPUT_FOLDER$"
!define PRODUCT_REQUIRED_VERCRC "$REQUIRED_VERSION_CRC$"
!define PRODUCT_LATEST_VERCRC "$LATEST_VERSION_CRC$"
!define PRODUCT_PUBLISHER "Gameone Online Entertainment Group Ltd."
!define PRODUCT_WEB_SITE "http://mg.51hit.com"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\QGLPU.exe"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_GAMEONE_QGL_KEY "Software\紫界网络\${PRODUCT_NAME}"
!define PRODUCT_UNINST_ROOT_KEY "HKLM"
!define FINISH_PAGE_APP "UpdatePatchU.exe"
!define FINISH_PAGE_PARAM "-s${PRODUCT_SUPPORT_FROM_PATCH_VERSION} -v${PRODUCT_DESTINATION_PATCH_VERSION} -c${PRODUCT_REQUIRED_VERCRC} -u${PRODUCT_LATEST_VERCRC} ${PRODUCT_REVERT_FLAG}"
!define INSTALL_TY_INSTALLER "1"
!define EXTRA_APP_1 "qglty_0.5.0_trial.exe"

!ifndef PRODUCT_SUPPORT_FROM_VERSION
        !error "PRODUCT_SUPPORT_FROM_VERSION not defined"
