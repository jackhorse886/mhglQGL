  RMDir "$SMPROGRAMS\×Ï½çÍøÂç\ÃÎ»Ã¹ÅÁú"
  RMDir "$SMPROGRAMS\×Ï½çÍøÂç"
  Delete "$DESKTOP\ÃÎ»Ã¹ÅÁú.lnk"

  RMDir "$INSTDIR\Config"
  RMDir "$INSTDIR\Data\Wav"
  RMDir "$INSTDIR\Data"
  RMDir "$INSTDIR\Patch"
  RMDir "$INSTDIR\res"
  RMDir "$INSTDIR\Data"
  RMDir "$INSTDIR\Error"
  RMDir "$INSTDIR\Log"
  RMDir "$INSTDIR"

  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_DIR_REGKEY}"
  DeleteRegKey HKLM "${PRODUCT_GAMEONE_QGL_KEY}"
  SetAutoClose true
SectionEnd

