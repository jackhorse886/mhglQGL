Section Uninstall
  Delete "$INSTDIR\*"
  Delete "$INSTDIR\Data\*"
  Delete "$INSTDIR\Data\Wav\*"
  Delete "$INSTDIR\Config\*"
  Delete "$INSTDIR\Patch\*"
  Delete "$INSTDIR\res\*"
  Delete "$INSTDIR\Error\*"
  Delete "$INSTDIR\Log\*"

  Delete "$SMPROGRAMS\×Ï½çÍøÂç\ÃÎ»Ã¹ÅÁú\Uninstall.lnk"
  Delete "$SMPROGRAMS\×Ï½çÍøÂç\ÃÎ»Ã¹ÅÁú\ÃÎ»Ã¹ÅÁúÖ÷Ò³.lnk"
