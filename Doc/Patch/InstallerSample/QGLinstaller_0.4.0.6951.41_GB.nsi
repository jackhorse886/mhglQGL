Section "MainSection" SEC01
  SetOverwrite try
  SetOutPath "$INSTDIR"
  File "*.dll"
;  File "QGLPU.exe"
  File "QGLPU.bin"
  File "QGLPatcherU.exe"
;  File "UpdateU.exe"
  File "UpdateU.bin"
  SetOutPath "$INSTDIR\Data\Wav"
  File "Data\Wav\*"
  SetOutPath "$INSTDIR\Data"
  File "Data\*.ogg"
  File "Data\*.gdf"
  SetOutPath "$INSTDIR\Config"
  File "Config\*.ini"
  SetOutPath "$INSTDIR\res"
  File "res\*.*"
  SetOutPath "$INSTDIR"
  CreateDirectory "$INSTDIR\Error"
  CreateDirectory "$INSTDIR\Log"
  CreateDirectory "$INSTDIR\Patch"
