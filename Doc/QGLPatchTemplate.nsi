        !error "PRODUCT_SUPPORT_FROM_PATCH_VERSION not defined"
!endif
!ifndef PRODUCT_DESTINATION_VERSION
        !error "PRODUCT_DESTINATION_VERSION not defined"
!endif
!ifndef PRODUCT_DESTINATION_PATCH_VERSION
        !error "PRODUCT_DESTINATION_PATCH_VERSION not defined"
!endif

; MUI 1.67 compatible ------
!include "MUI.nsh"

; MUI Settings
!define MUI_ABORTWARNING
!define MUI_ICON "..\..\..\QGL.ico"
!define MUI_UNICON "${NSISDIR}\Contrib\Graphics\Icons\modern-uninstall.ico"

; Language Selection Dialog Settings
!define MUI_LANGDLL_REGISTRY_ROOT "${PRODUCT_UNINST_ROOT_KEY}"
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "NSIS:Language"

;Page custom CustomPageFunction

; Welcome page
