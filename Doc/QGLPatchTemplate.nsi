Section "MainSection" SEC01
  Delete "$INSTDIR\_*.gdf.patch"
  SetOverwrite try
  SetOutPath "$INSTDIR"
  File /nonfatal "_*.gdf.patch"
  File /nonfatal "QGLPU.exe"
  File /nonfatal "QGLPatcherU.exe"
  File /nonfatal "UpdateU.EXE"
  File /nonfatal "..\..\..\UpdatePatchU.exe"
  File /nonfatal "*.dll"
  SetOutPath "$INSTDIR\Data\Wav"
  File /nonfatal "Data\Wav\*"
  SetOutPath "$INSTDIR\Data"
  File /nonfatal "*.ogg"
  SetOutPath "$INSTDIR\Config"
  File /nonfatal "Config\*.ini"
  SetOutPath "$INSTDIR\res"
  File /nonfatal "res\*.*"
  SetOutPath "$INSTDIR"
  SetOverwrite ifnewer
; CreateDirectory "$SMPROGRAMS\Gameone"
; CreateDirectory "$SMPROGRAMS\Gameone\QGL"
; CreateShortCut "$SMPROGRAMS\Gameone\QGL\QGLLink.lnk" "http://qlo.gameone.com.cn"
; CreateShortCut "$SMPROGRAMS\Gameone\QGL\QGL.lnk" "$INSTDIR\QGLPatcherU.exe"
; CreateShortCut "$DESKTOP\QGLLink.lnk" "http://qlo.gameone.com.cn"
; CreateShortCut "$DESKTOP\QGL.lnk" "$INSTDIR\QGLPatcherU.exe"
SectionEnd

Section -AdditionalIcons
; WriteIniStr "$INSTDIR\${PRODUCT_NAME}.url" "InternetShortcut" "URL" "${PRODUCT_WEB_SITE}"
; CreateShortCut "$SMPROGRAMS\Gameone\QGL\QGL.lnk" "$INSTDIR\${PRODUCT_NAME}.url"
; CreateShortCut "$SMPROGRAMS\Gameone\QGL\Uninstall.lnk" "$INSTDIR\uninst.exe"
SectionEnd

Section -Post
  ${WriteToFile} "${FINISH_PAGE_APP} ${FINISH_PAGE_PARAM}" "$INSTDIR\_instcmd.txt"
  WriteUninstaller "$INSTDIR\uninst.exe"
  WriteRegStr HKLM "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\QGLPU.exe"
  WriteRegStr HKLM "${PRODUCT_GAMEONE_QGL_KEY}" "AppDir" "$INSTDIR"
  WriteRegStr HKLM "${PRODUCT_GAMEONE_QGL_KEY}" "Build" "${PRODUCT_BUILD}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayName" "$(^Name)"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\uninst.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "$INSTDIR\QGLPU.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "URLInfoAbout" "${PRODUCT_WEB_SITE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
SectionEnd


Function un.onUninstSuccess
  HideWindow
  MessageBox MB_ICONINFORMATION|MB_OK "$(^Name) 已成功地從你的電腦移除。"
FunctionEnd

Function un.onInit
!insertmacro MUI_UNGETLANGUAGE
  MessageBox MB_ICONQUESTION|MB_YESNO|MB_DEFBUTTON2 "你確定要完全移除 $(^Name) ，其及所有的元件？" IDYES +2
  Abort
FunctionEnd

Section Uninstall
  Delete "$INSTDIR\${PRODUCT_NAME}.url"
  Delete "$INSTDIR\*"
  Delete "$INSTDIR\Data\*"
  Delete "$INSTDIR\Data\Wav\*"
  Delete "$INSTDIR\Config\*"
  Delete "$INSTDIR\Error\*"
  Delete "$INSTDIR\Log\*"

  Delete "$SMPROGRAMS\Gameone\QGL\Uninstall.lnk"
  Delete "$SMPROGRAMS\Gameone\QGL\Gameone.lnk"
  Delete "$DESKTOP\QGL.lnk"
  Delete "$SMPROGRAMS\Gameone\QGL\QGL.lnk"

  RMDir "$SMPROGRAMS\Gameone\QGL"
  RMDir "$SMPROGRAMS\Gameone"
  RMDir "$INSTDIR\Config"
  RMDir "$INSTDIR\Data\Wav"
  RMDir "$INSTDIR\Data"
  RMDir "$INSTDIR\Error"
  RMDir "$INSTDIR\Log"
  RMDir "$INSTDIR"

  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_DIR_REGKEY}"
  DeleteRegKey HKLM "${PRODUCT_GAMEONE_QGL_KEY}"
  SetAutoClose true
SectionEnd