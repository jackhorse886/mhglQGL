Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile "..\..\..\UpdatePatch\qgl_${PRODUCT_SUPPORT_FROM_VERSION}.${PRODUCT_SUPPORT_FROM_PATCH_VERSION}_${PRODUCT_DESTINATION_VERSION}.${PRODUCT_DESTINATION_PATCH_VERSION}_patch.exe"
InstallDir "$PROGRAMFILES\Gameone\QGL"
InstallDirRegKey HKLM "${PRODUCT_DIR_REGKEY}" ""
ShowInstDetails show
ShowUnInstDetails show

Function WriteToFile
 Exch $0 ;file to write to
 Exch
 Exch $1 ;text to write

  FileOpen $0 $0 w #open file
   FileSeek $0 0 SET #go to end
   FileWrite $0 $1 #write to file
  FileClose $0

 Pop $1
 Pop $0
FunctionEnd

!macro WriteToFile String File
 Push "${String}"
 Push "${File}"
  Call WriteToFile
!macroend
!define WriteToFile "!insertmacro WriteToFile"

;Function CustomPageFunction
;InstallOptions::dialog "testbmp.ini"
;;  !insertmacro INSTALLOPTIONS_DISPLAY "testbmp.ini"
;FunctionEnd

;Function .onInit
;;  !insertmacro MUI_LANGDLL_DISPLAY
